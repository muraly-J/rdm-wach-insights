# WACH Insight Backend - Environment Configuration
# ==================================================
# Copy this file to .env and fill in your actual values
#
# Required for backend to connect to InfluxDB and LM Studio (LLM)

# ── InfluxDB Configuration ───────────────────────────────────────────────
# The time-series database storing AHU electrical metrics
#
# Development (Local): http://localhost:8086 or http://127.0.0.1:8086
# Production (IP Address): https://178.128.53.199:8086
# Production (Cloud Domain): https://your-influxdb-host.cloud.influxdata.com
#
# ⚠️ IMPORTANT: IP addresses and domains MUST use HTTPS for secure communication
INFLUX_URL=http://localhost:8086

# API token with read access to the wach_bucket_3 bucket (REQUIRED)
INFLUX_TOKEN=your-influxdb-api-token-here

# Organization name (default: wach)
INFLUX_ORG=wach

# Bucket name containing AHU metrics
INFLUX_BUCKET=wach_bucket_3


# ── LLM Backend Selection ────────────────────────────────────────────────
# Controls which LLM is used for /api/chat and query translation.
# Options: qwen (default, local via LM Studio) | gemini (Google AI Studio)
LLM_BACKEND=qwen

# ── LM Studio (local Qwen) ───────────────────────────────────────────────
# Used when LLM_BACKEND=qwen
LMS_BASE_URL=http://localhost:1234/v1

# Model name (must match what's loaded in LM Studio)
LMS_MODEL=qwen/qwen3-coder-next

# API key for LM Studio (REQUIRED - set to valid token or "lm-studio")
LMS_API_KEY=your-lmstudio-api-key-here

# ── Google Gemini (cloud) ─────────────────────────────────────────────────
# Used when LLM_BACKEND=gemini
# GEMINI_API_KEY=your-google-ai-studio-key-here
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001


# ── Application Security Configuration ───────────────────────────────────
# API key for authenticating all /api endpoints (REQUIRED)
API_KEY=your-api-key-change-in-production

# Developer API key for local development without external auth
DEV_API_KEY=dev-key-change-in-production

# Enable debug mode for development (True/False)
DEBUG=false

# CORS origins - comma-separated list of allowed frontend URLs
# Example: http://localhost:3000,http://192.168.1.100:3000
CORS_ORIGINS=http://localhost:3000

# Rate limiting (requests per window)
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=60


# ── Health Score Data Path (optional) ───────────────────────────────────
# Path to pre-generated health score CSV files
# DATA_DIR=/app/data


# ── Example Production Configuration ────────────────────────────────────
# If using InfluxDB Cloud:
# INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
# INFLUX_TOKEN=inflx_token_abc123xyz789...
#
# If LM Studio is running on a different machine:
# LMS_BASE_URL=http://192.168.1.50:1234/v1
#
# API key example:
# API_KEY=prod_api_key_abc123xyz789...

