{"version": 2,
  "builds": [
    {"src": "backend/main.py", "use": "@vercel/python"},
    {"src": "frontend/package.json", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/backend/main.py"},
    {"src": "/(.*)", "dest": "/frontend/dist/$1"}
  ],
  "installCommand": "cd frontend && npm install",
  "outputDirectory": "frontend/dist"
}
