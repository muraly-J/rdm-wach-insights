{"version": 2, "builds": [{"src": "backend/main.py", "use": "@vercel/python"}, {"src": "frontend/package.json", "use": "@vercel/static"}], "routes": [{"src": "/api/(.*)", "dest": "backend/main.py"}, {"src": "/assets/(.*)", "dest": "frontend/dist/assets/$1"}, {"src": "/(.*)", "dest": "frontend/dist/index.html"}], "installCommand": "pip install --break-system-packages -r backend/requirements.txt", "outputDirectory": "frontend/dist"}
