# Git attributes for WACH Insight

# Auto-normalize line endings (LF only, except on Windows checkout)
* text=auto

# Explicitly text files (ensure LF)
*.md text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tar.gz binary
*.pdf binary
*.parquet binary

# Ensure shell scripts have LF line endings (for Docker/Unix compatibility)
scripts/** text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# LFS files (data)
data/*.csv filter=lfs diff=lfs merge=lfs -text
data/healthdb.duckdb filter=lfs diff=lfs merge=lfs -text
*.sqlite3 binary
*.duckdb binary

# Always use LF for cron files
*.cron text eol=lf
