[flake8]
max-line-length = 100
extend-ignore = E501, E203, W503
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    backend/venv,
    backend/.venv,
    node_modules,
    frontend/node_modules,
    frontend/dist,
    frontend/coverage,
    .mypy_cache,
    .ruff_cache,
    .pytest_cache,
    dist,
    build,
    paraquet_data,
    data
