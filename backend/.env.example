# WACH Insight - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your actual values.
# Do NOT commit .env to version control!

# ── InfluxDB Configuration (Required for production) ───────────────────────
# Get these from your InfluxDB Cloud or self-hosted instance
INFLUX_URL=https://us-east-1-1.aws.cloud.influxdata.com      # e.g., http://localhost:8086
INFLUX_TOKEN=your-influxdb-api-token-here                     # API token with read/write access
INFLUX_ORG=wach                                               # Your organization name
INFLUX_BUCKET=wach_bucket_3                                   # Your bucket name

# ── LM Studio (LLM) Configuration ───────────────────────────────────────────
# Required for query translation. Ensure LM Studio is running with a model loaded.
LMS_BASE_URL=http://localhost:1234/v1                         # LM Studio API endpoint
LMS_MODEL=qwen/qwen3-coder-next                               # Model name as it appears in LM Studio
LMS_API_KEY=lm-studio                                         # Placeholder; LM Studio ignores this

# ── Application Configuration ───────────────────────────────────────────────
APP_ENV=development                                           # development, staging, or production

# CORS: Comma-separated list of allowed origins
# For Vercel deployment, add your production URL:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://rdm-wach-insights.vercel.app

# Rate limiting (requests per window)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# Debug mode (disable in production for security)
DEBUG=false
